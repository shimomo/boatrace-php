{
    "name": "boatrace/core",
    "description": "Boatrace Core",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "shimomo",
            "email": "yuichi@shimomo.net"
        }
    ],
    "require": {
        "php": "^8.4",
        "boatrace/types": "^0.2.0",
        "php-di/php-di": "^7.0",
        "symfony/browser-kit": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.2",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "Boatrace\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Boatrace\\Core\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    },
    "$schema": "https://getcomposer.org/schema.json"
}
