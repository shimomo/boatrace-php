{
    "name": "boatrace/support",
    "description": "Boatrace Support",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "shimomo",
            "email": "yuichi@shimomo.net"
        }
    ],
    "require": {
        "php": "^8.4",
        "boatrace/core": "^0.2.0",
        "boatrace/types": "^0.2.0",
        "symfony/browser-kit": "^8.0",
        "symfony/console": "^8.0",
        "symfony/css-selector": "^8.0",
        "symfony/dom-crawler": "^8.0",
        "symfony/http-client": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.2",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "Boatrace\\Support\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Boatrace\\Support\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    },
    "$schema": "https://getcomposer.org/schema.json"
}
